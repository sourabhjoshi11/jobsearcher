# -----------------------------------------------------------------------
# Job Alert Bot — environment variables
# Copy to .env and fill in real values. Never commit .env to git.
# -----------------------------------------------------------------------

# Runtime
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# Telegram
TELEGRAM_BOT_TOKEN=              # from @BotFather
WEBHOOK_URL=                     # public base URL e.g. https://yourapp.railway.app
                                 # leave empty for local polling mode

# Database (Docker Compose defaults shown)
DATABASE_URL=postgresql://jobalert:jobalert_dev_pw@localhost:5432/jobalertbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Razorpay (Phase 5 — leave empty until you're ready to accept payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
